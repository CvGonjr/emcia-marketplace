      "nome": "mcp__claude_ai_Google_Calendar__list_events",
      "descricao": "Returns events on the given calendar matching all specified constraints.",
      "parametros": [
        {
          "nome": "calendarId",
          "tipo": "string",
          "obrigatorio": false,
          "valores_aceitos": null,
          "descricao": "Optional. ID of the calendar. Default: primary calendar."
        },
        {
          "nome": "startTime",
          "tipo": "string (ISO 8601)",
          "obrigatorio": false,
          "valores_aceitos": null,
          "descricao": "Optional. The lower bound of a time range. Default: now."
