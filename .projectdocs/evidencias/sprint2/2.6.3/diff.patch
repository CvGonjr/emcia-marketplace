+{
+  "nome": "Rotina de recalibragem",
+  "versao": "0.1.0",
+  "referencia": "EMCIA-CAM-01 3.6/Anexo D, EMCIA-MET-01 3.4.10, EMCIA-CAT-01 3.4.5",
+  "procedencia": ["D", "I", "V"],
+  "objetos": {
+    "rotina_calibragem": {
+      "id_pattern": "CAL-[0-9]{3,}",
+      "required": [
+        "id", "metricas_ref", "responsavel", "responsavel_ciente",
+        "cadencia", "data_primeira_revisao", "limiares_desvio",
+        "monitoramento", "canal_incidente", "analise_pos_incidente",
+        "procedencia", "declarado_por", "registrado_por", "data", "versao"
+      ],
